{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "compile & bundle",
			"dependsOrder": "sequence",
			"dependsOn": ["npm: compile", "npm: build"],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"presentation": {
				"reveal": "silent"
			}
		},
		{
			"type": "npm",
			"script": "compile",
			"problemMatcher": "$tsc",
			"presentation": {
				"reveal": "never"
			}
		},
		{
			"type": "npm",
			"script": "build",
			"problemMatcher": [],
			"presentation": {
				"reveal": "never"
			}
		}
	]
}
